# ===== PetFactory API 配置 =====

# 【推荐】AIGate（视觉看图 + 角色档案 + 动态壁纸视频）
# 开通地址：https://llm.chudian.site
# 视觉/档案模型默认 glm-5.3-flash（原生多模态、能看图、1M上下文）
# 备选省钱：mimo-v2.6-flash；推理编排：deepseek-v4.1-flash
# 视频模型默认 agnes-video-v2.0（480P/720P/1080P，支持单图生视频）
# 备选视频：agnes-video-2.5 / minimax-h3 / wan3.0-video
AIGATE_API_KEY=sk-ag-xxxxxxxx
AIGATE_BASE_URL=https://llm.chudian.site/v1
AIGATE_MODEL=glm-5.3-flash
AIGATE_VIDEO_MODEL=agnes-video-v2.0

# 【必填】火山引擎方舟 Ark（仅用于图片生成：15帧 + 像素头像）
# 开通地址：https://console.volcengine.com/ark
# 生图模型必须 2048x2048（接口要求≥3,686,400像素）
ARK_API_KEY=your_ark_api_key_here
ARK_IMAGE_MODEL=doubao-seedream-5-0-260128

# 【可选】方舟视觉理解（需创建推理接入点 ep-xxx，AIGate 不可用时备选）
# ARK_VISION_MODEL=ep-xxxxxxxx

# 【可选】方舟文本模型（需创建推理接入点 ep-xxx，AIGate 不可用时备选）
# ARK_TEXT_MODEL=ep-xxxxxxxx

# 【桌宠聊天专用】DeepSeek（聊天固定走 DeepSeek，不走 AIGate）
# 开通地址：https://platform.deepseek.com
# 未配置时聊天窗友好提示，不影响桌宠其他功能
DEEPSEEK_API_KEY=your_deepseek_api_key_here